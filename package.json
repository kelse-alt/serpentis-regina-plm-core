{
  "name": "serpentis-regina-plm-core",
  "private": true,
  "version": "0.3.1",
  "description": "A versioned fashion measurement register built with JavaScript, SQLite, and an offline browser report",
  "repository": {
    "type": "git",
    "url": "https://github.com/kelse-alt/serpentis-regina-plm-core.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sheet": "node src/house-measurement-sheet.mjs",
    "db:import": "node src/house-measurement-database.mjs import",
    "sheet:db": "node src/house-measurement-database.mjs sheet",
    "generator": "node src/measurement-generator-server.mjs",
    "generator:build": "node scripts/build-measurement-generator.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
