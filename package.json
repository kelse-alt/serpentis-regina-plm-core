{
  "name": "serpentis-regina-plm-core",
  "private": true,
  "version": "0.5.0",
  "description": "Local fashion technical-design workroom with six-tab tech packs, client intake and an approved fit-form register",
  "repository": {
    "type": "git",
    "url": "https://github.com/kelse-alt/serpentis-regina-plm-core.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sheet": "node src/house-measurement-sheet.mjs",
    "db:import": "node src/house-measurement-database.mjs import",
    "sheet:db": "node src/house-measurement-database.mjs sheet",
    "generator": "node src/measurement-generator-server.mjs",
    "generator:build": "node scripts/build-measurement-generator.mjs",
    "intake": "node src/client-intake-server.mjs",
    "intake:build": "node scripts/build-client-intake.mjs",
    "test": "node --test tests/*.test.mjs",
    "techpack:build": "node scripts/build-tech-pack.mjs",
    "techpack": "node scripts/serve-tech-pack.mjs"
  }
}
